# Gemini is optional and disabled by default. Set the API key ONLY on the server.
# Do not publish this file with a real key; use .env locally or hosting secrets.
# GEMINI_API_KEY=your-server-side-key
# GEMINI_MODEL=gemini-2.5-flash
# CAREKAKI_LLM_MODE=on
# CAREKAKI_LLM_TIMEOUT_MS=15000
# off = deterministic matching, shadow = infer but keep deterministic output,
# on = Gemini-powered extraction and eligibility-safe provider ranking.
# Public deployment requires authentication and request rate limits before enabling AI.

# Path to the provider CSV. Relative paths resolve from the project root.
CAREKAKI_PROVIDERS_CSV=./carekaki_providers_demo.csv

# Streamable HTTP entrypoint (dist/http.js) only.
# NODE_ENV=production makes the default bind host 0.0.0.0 (single public port
# also serves the Angular SPA). Leave HOST unset to use that default, or set it
# explicitly. See DEPLOY.md for the full single-port model.
PORT=3000
# HOST=127.0.0.1
# NODE_ENV=production

# Extra Origin hostnames allowed to call /mcp (comma-separated, no wildcard).
# Loopback names are always allowed. Set "*" to disable the Origin guard (public
# demo hosting). See DEPLOY.md.
# ALLOWED_ORIGINS=myapp.example.com,carekaki.example.com

# Extra Host header hostnames accepted when binding off the loopback (comma-separated).
# Set "*" to disable the Host (DNS-rebinding) guard — needed when a platform
# reverse proxy forwards an unknown public hostname. `npm run serve:prod` does
# this automatically unless PUBLIC_URL or CAREKAKI_STRICT_HOSTS=1 is set.
# ALLOWED_HOSTS=myapp.example.com,carekaki.example.com

# Full public URL of the deployment; its hostname is auto-added to ALLOWED_HOSTS.
# PUBLIC_URL=https://carekaki.example.com

# Set to 1 to keep the strict host/origin guard even behind a public proxy.
# CAREKAKI_STRICT_HOSTS=1
