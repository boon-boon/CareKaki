# Path to the provider CSV. Relative paths resolve from the project root.
CAREKAKI_PROVIDERS_CSV=./carekaki_providers_demo.csv

# Streamable HTTP entrypoint (dist/http.js) only.
# NODE_ENV=production makes the default bind host 0.0.0.0 (single public port
# also serves the Angular SPA). Leave HOST unset to use that default, or set it
# explicitly. See DEPLOY.md for the full single-port model.
PORT=3000
# HOST=127.0.0.1
# NODE_ENV=production

# Extra Origin hostnames allowed to call /mcp (comma-separated, no wildcard).
# Loopback names are always allowed.
# ALLOWED_ORIGINS=myapp.example.com,carekaki.example.com

# Extra Host header hostnames accepted when binding off the loopback (comma-separated).
# ALLOWED_HOSTS=myapp.example.com,carekaki.example.com
