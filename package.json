{
  "name": "carekaki-mcp",
  "version": "1.0.0",
  "description": "CareKaki care-provider matching, exposed as an MCP server (ported from n8n)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "carekaki-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "carekaki_providers_demo.csv"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "stdio": "node --env-file-if-exists=.env dist/index.js",
    "http": "node --env-file-if-exists=.env dist/http.js",
    "smoke": "node dist/smoke.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ux:build": "npm --prefix carekaki-ux run build",
    "ux:start": "npm --prefix carekaki-ux start"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
